# Project Name
PROJECT = GPIO

# Toolchain
PREFIX  = arm-none-eabi-
CC      = $(PREFIX)gcc
AS      = $(PREFIX)gcc -x assembler-with-cpp
OBJCOPY = $(PREFIX)objcopy
OBJDUMP = $(PREFIX)objdump
SIZE    = $(PREFIX)size

# MCU Settings
MCU      = cortex-m0plus
FLOAT-ABI = soft

# Directories
PRJ_DIR  = ..
GCC_DIR  = .
TOP_DIR  = $(PRJ_DIR)/../../..
OUTPUT_DIR = $(GCC_DIR)/Output

DEVICE_DIR  = $(TOP_DIR)/Device/LH32M0G3x
DRIVERS_DIR = $(TOP_DIR)/Drivers
LHL_DIR     = $(DRIVERS_DIR)/LHL/LH32M0G3x
CMSIS_DIR   = $(DRIVERS_DIR)/CMSIS

# Source files - C
SRC_C = \
    $(PRJ_DIR)/main.c \
    $(PRJ_DIR)/lh32m0xx_it.c \
    $(DEVICE_DIR)/system_lh32m0g3x.c \
    $(TOP_DIR)/Device/LH32M0G3x/GCC/syscalls.c \
    $(LHL_DIR)/lib/lh32m0g3x_lhl.c \
    $(LHL_DIR)/lib/lh32m0g3x_gpio.c \
    $(LHL_DIR)/lib/lh32m0g3x_rcc.c \
    $(LHL_DIR)/lib/lh32m0g3x_iwdg.c \
    $(LHL_DIR)/lib/lh32m0g3x_power.c \
    $(LHL_DIR)/lib/lh32m0g3x_exti.c

# Source files - Assembly
SRC_S = $(TOP_DIR)/Device/LH32M0G3x/GCC/startup_lh32m0g3x_gcc.s

# Include paths
INCLUDES = \
    -I$(PRJ_DIR) \
    -I$(DEVICE_DIR) \
    -I$(LHL_DIR)/inc \
    -I$(CMSIS_DIR)/Include \
    -I$(CMSIS_DIR)/Core/Include

# Compiler flags
CFLAGS  = -mcpu=$(MCU) -mthumb -mfloat-abi=$(FLOAT-ABI)
CFLAGS += -Wall -Wextra
CFLAGS += -Wno-unused-parameter -Wno-unused-variable
CFLAGS += -ffunction-sections -fdata-sections
CFLAGS += -g -O1
CFLAGS += $(INCLUDES)

CFLAGS += -std=c99

# Assembler flags
ASFLAGS  = -mcpu=$(MCU) -mthumb -mfloat-abi=$(FLOAT-ABI)
ASFLAGS += -Wall -g
ASFLAGS += $(INCLUDES)

# Linker flags
LDFLAGS  = -mcpu=$(MCU) -mthumb -mfloat-abi=$(FLOAT-ABI)
LDFLAGS += -Wl,-Map=$(OUTPUT_DIR)/$(PROJECT).map
LDFLAGS += -Wl,--gc-sections
LDFLAGS += -specs=nano.specs
LDFLAGS += -T$(GCC_DIR)/linker.ld
LDFLAGS += -lc -lm -lnosys

# Objects
OBJS = $(addprefix $(OUTPUT_DIR)/, $(notdir $(SRC_C:.c=.o)) $(notdir $(SRC_S:.s=.o)))

VPATH = $(dir $(SRC_C)) $(dir $(SRC_S))

# Default target
all: $(OUTPUT_DIR) $(OUTPUT_DIR)/$(PROJECT).elf $(OUTPUT_DIR)/$(PROJECT).hex $(OUTPUT_DIR)/$(PROJECT).bin
	@echo "========================================"
	@echo " Build complete: $(PROJECT)"
	@echo "========================================"
	$(SIZE) $(OUTPUT_DIR)/$(PROJECT).elf

$(OUTPUT_DIR):
	-mkdir $(subst /,\,$@)

# Link
$(OUTPUT_DIR)/$(PROJECT).elf: $(OBJS)
	@echo "Linking..."
	$(CC) $(OBJS) $(LDFLAGS) -o $@

# Compile C sources
$(OUTPUT_DIR)/%.o: %.c | $(OUTPUT_DIR)
	@echo "CC $<"
	$(CC) -c $(CFLAGS) $< -o $@

# Compile ASM sources
$(OUTPUT_DIR)/%.o: %.s | $(OUTPUT_DIR)
	@echo "AS $<"
	$(AS) -c $(ASFLAGS) $< -o $@

# Generate hex file
$(OUTPUT_DIR)/%.hex: $(OUTPUT_DIR)/%.elf
	$(OBJCOPY) -O ihex $< $@

# Generate bin file
$(OUTPUT_DIR)/%.bin: $(OUTPUT_DIR)/%.elf
	$(OBJCOPY) -O binary $< $@

# Clean
clean:
	-if exist $(subst /,\,$(OUTPUT_DIR)) rmdir /s /q $(subst /,\,$(OUTPUT_DIR))
	@echo "Clean complete"

.PHONY: all clean
